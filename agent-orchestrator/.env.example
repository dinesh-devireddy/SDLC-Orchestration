# Copy to .env. Never commit your real key.
LLM_API_KEY=replace-me
# Set a model offered by your provider with structured-output support.
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# json_schema for native structured output; function_calling for compatible servers.
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
LLM_TIMEOUT_SECONDS=60
